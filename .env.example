# OpenForge root development environment
#
# Copy only the service templates you need from envs/examples/ into
# envs/local/. Never commit files from envs/local/.

OPENFORGE_ENV=development
OPENFORGE_PUBLIC_URL=http://localhost:3000
OPENFORGE_API_URL=http://localhost:4000
OPENFORGE_PREVIEW_URL=http://localhost:4100
OPENFORGE_PYTHON_URL=http://localhost:8000

# Required secret-bearing values are intentionally blank.
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
ENCRYPTION_MASTER_KEY=
SESSION_SECRET=
