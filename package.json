{
  "name": "openforge",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source visual development environment for portable Next.js projects.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "prettier --check . && turbo run lint test build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "pnpm": "11.17.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "vitest": "4.1.10"
  }
}
