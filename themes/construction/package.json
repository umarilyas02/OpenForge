{
  "name": "@openforge/theme-construction",
  "version": "0.0.0",
  "private": true,
  "description": "Construction / home-services OpenForge CMS theme: a rugged, trustworthy safety-orange-on-charcoal kit with page, post, and not-found templates plus a five-page example site for a general contractor.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=dist/index.js",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@openforge/cms-blocks": "workspace:*",
    "@openforge/theme-sdk": "workspace:*",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@openforge/renderer": "workspace:*",
    "esbuild": "0.28.2",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
