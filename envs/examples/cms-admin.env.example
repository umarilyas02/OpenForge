NODE_ENV=development
PORT=3903
DATABASE_URL=
# Directory each site's real project files are written to (one
# subdirectory per site, named after its slug). Put this on a persistent
# volume when deployed — it's the site's actual content, equivalent in
# durability to a database. Defaults to ./data/sites if unset.
SITES_STORAGE_PATH=
# Public: used client-side to build "view live site" links. Points at
# apps/cms-renderer's public origin; a site's slug is inserted as a
# subdomain unless the site has its own custom domain.
NEXT_PUBLIC_CMS_RENDERER_ORIGIN=http://localhost:3902
